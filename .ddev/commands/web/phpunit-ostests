#!/usr/bin/env bash

## Description: Run the isolated object-store (MinIO) test suite in ostests/ — separate from the Drupal GitLab tests/ run
## Usage: phpunit-ostests [options]
## Example: "ddev phpunit-ostests --filter Foo"

set -e
SIMPLETEST_DB=mysql://db:db@db/test SIMPLETEST_BASE_URL=http://web \
  /var/www/html/vendor/bin/phpunit \
    -c /var/www/html/web/modules/custom/flysystem/ostests/phpunit.xml \
  "$@"